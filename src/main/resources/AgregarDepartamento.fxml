<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="433.0" prefWidth="770.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecodeup.jdbc.poofx.Controlador">
   <children>
      <ImageView fitHeight="500.0" fitWidth="900.0" layoutY="1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/AD.png" />
         </image>
      </ImageView>
      <Text fill="WHITE" layoutX="289.0" layoutY="57.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Agregar Departamento">
         <font>
            <Font name="Comic Sans MS" size="29.0" />
         </font>
      </Text>
      <Button layoutX="551.0" layoutY="290.0" mnemonicParsing="false" onAction="#handleAgregarDepartamento" prefHeight="26.0" prefWidth="186.0" style="-fx-background-color: #5DE6A8; -fx-background-radius: 15;" text="Agregar Departamento">
         <font>
            <Font name="Comic Sans MS" size="12.0" />
         </font></Button>
      <Button layoutX="584.0" layoutY="354.0" mnemonicParsing="false" onAction="#Departamento" prefHeight="26.0" prefWidth="119.0" text="Regresar">
         <font>
            <Font name="Comic Sans MS" size="12.0" />
         </font></Button>
      <TextField fx:id="txtNombreDpto" layoutX="615.0" layoutY="122.0" promptText="Nombre" style="-fx-background-radius: 10;" />
      <Text fill="WHITE" layoutX="436.0" layoutY="140.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre del departamento: ">
         <font>
            <Font name="Comic Sans MS" size="14.0" />
         </font>
      </Text>
      <Text fill="WHITE" layoutX="436.0" layoutY="194.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID del departamento:">
         <font>
            <Font name="Comic Sans MS" size="14.0" />
         </font>
      </Text>
      <Text fill="WHITE" layoutX="436.0" layoutY="242.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Valoracion del departamento">
         <font>
            <Font name="Comic Sans MS" size="14.0" />
         </font>
      </Text>
      <TextField fx:id="txtIdDpto" layoutX="580.0" layoutY="176.0" prefHeight="25.0" prefWidth="84.0" promptText="ID" style="-fx-background-radius: 10;" />
      <TextField fx:id="txtValoracionDpto" layoutX="631.0" layoutY="224.0" prefHeight="25.0" prefWidth="84.0" promptText="0-10" style="-fx-background-radius: 10;" />
   </children>
</AnchorPane>
