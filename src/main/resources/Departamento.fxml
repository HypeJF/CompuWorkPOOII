<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="450.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecodeup.jdbc.poofx.Controlador">
   <children>
      <ImageView fitHeight="500.0" fitWidth="900.0" layoutY="-7.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 15;">
         <image>
            <Image url="@Images/MD.png" />
         </image>
      </ImageView>
      <Text fill="WHITE" layoutX="271.0" layoutY="45.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gestion de Departamentos">
         <font>
            <Font name="Comic Sans MS" size="28.0" />
         </font>
      </Text>
      <Button layoutX="64.0" layoutY="152.0" mnemonicParsing="false" onAction="#AgregarDepartamento" prefHeight="39.0" prefWidth="207.0" style="-fx-background-radius: 15; -fx-background-color: #5DE6A8;" text="Agregar Departamento">
         <font>
            <Font name="Comic Sans MS" size="16.0" />
         </font></Button>
      <Button layoutX="617.0" layoutY="152.0" mnemonicParsing="false" onAction="#ModificarDepartamento" prefHeight="39.0" prefWidth="207.0" style="-fx-background-radius: 15; -fx-background-color: #5DE6A8;" text="Modificar Departamento">
         <font>
            <Font name="Comic Sans MS" size="16.0" />
         </font></Button>
      <Button layoutX="64.0" layoutY="270.0" mnemonicParsing="false" onAction="#EliminarDepartamento" prefHeight="39.0" prefWidth="207.0" style="-fx-background-radius: 15; -fx-background-color: #5DE6A8;" text="Eliminar Departamento">
         <font>
            <Font name="Comic Sans MS" size="16.0" />
         </font></Button>
      <Button layoutX="617.0" layoutY="270.0" mnemonicParsing="false" onAction="#ListaEmpleadosDepartamento" prefHeight="39.0" prefWidth="207.0" style="-fx-background-radius: 15; -fx-background-color: #5DE6A8;" text="Ver Empleados" wrapText="true">
         <font>
            <Font name="Comic Sans MS" size="16.0" />
         </font></Button>
      <Button layoutX="395.0" layoutY="405.0" mnemonicParsing="false" onAction="#Regresar" prefHeight="23.0" prefWidth="99.0" text="Regresar">
         <font>
            <Font name="Comic Sans MS" size="16.0" />
         </font></Button>
   </children>
</AnchorPane>
