<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="450.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ecodeup.jdbc.poofx.Controlador">
   <children>
      <ImageView fitHeight="500.0" fitWidth="900.0" layoutX="1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/ME2.png" />
         </image>
      </ImageView>
      <Text fill="WHITE" layoutX="254.0" layoutY="46.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Modificar un Empleado">
         <font>
            <Font name="Comic Sans MS" size="30.0" />
         </font>
      </Text>
      <Button layoutX="319.0" layoutY="346.0" mnemonicParsing="false" onAction="#handleModificarEmpleado" prefHeight="25.0" prefWidth="195.0" style="-fx-background-color: #5DE6A8; -fx-background-radius: 15;" text="Modificar Empleado">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font></Button>
      <Button layoutX="366.0" layoutY="401.0" mnemonicParsing="false" onAction="#Empleado" prefHeight="23.0" prefWidth="99.0" text="Regresar">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font></Button>
      <TextField fx:id="textNuevoNombreEmpleado" layoutX="321.0" layoutY="192.0" promptText="Nombre" style="-fx-background-radius: 10;">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font></TextField>
      <Text fill="WHITE" layoutX="221.0" layoutY="213.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nuevo nombre:">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font>
      </Text>
      <Text fill="WHITE" layoutX="221.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID del Nuevo departamento:">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font>
      </Text>
      <Text fill="WHITE" layoutX="221.0" layoutY="319.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nueva valoración:">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font>
      </Text>
      <TextField fx:id="textIdDptoModificarEmpleado" layoutX="410.0" layoutY="99.0" prefHeight="25.0" prefWidth="84.0" promptText="ID" style="-fx-background-radius: 10;">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font></TextField>
      <TextField fx:id="textNuevaValoracionModificar" layoutX="337.0" layoutY="298.0" prefHeight="25.0" prefWidth="84.0" promptText="0-10" style="-fx-background-radius: 10;">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font></TextField>
      <Text fill="WHITE" layoutX="221.0" layoutY="166.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID del empleado que desea modificar:">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font>
      </Text>
      <TextField fx:id="textIdEmpleadoModificar" layoutX="474.0" layoutY="145.0" prefHeight="25.0" prefWidth="84.0" promptText="ID" style="-fx-background-radius: 10;">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font></TextField>
      <Text fill="WHITE" layoutX="225.0" layoutY="264.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nuevo email:">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font>
      </Text>
      <TextField fx:id="textNuevoEmailModificar" layoutX="317.0" layoutY="243.0" promptText="E-Mail" style="-fx-background-radius: 10;">
         <font>
            <Font name="Comic Sans MS Italic" size="14.0" />
         </font></TextField>
   </children>
</AnchorPane>
